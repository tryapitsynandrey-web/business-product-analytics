# Normalize text files for cross-platform development.
* text=auto eol=lf

# Source and configuration files.
*.py text eol=lf diff=python
*.pyi text eol=lf diff=python
*.md text eol=lf diff=markdown
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.env.example text eol=lf
*.cfg text eol=lf
*.csv text eol=lf
*.ini text eol=lf
*.lock text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
Makefile text eol=lf

# Data snapshots are text, but should be treated as generated portfolio artifacts.
data/synthetic/*.csv text eol=lf linguist-generated=true
data/processed/*.csv text eol=lf linguist-generated=true
data/exports/*.csv text eol=lf linguist-generated=true
reports/*.md text eol=lf linguist-generated=true

# Notebooks are JSON text but noisy in diffs.
*.ipynb text eol=lf linguist-generated=true

# Binary artifacts.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.parquet binary
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.pptx binary
*.docx binary

# Keep local-only and generated caches out of source archives.
.venv/** export-ignore
.agents/** export-ignore
.antigravity/** export-ignore
.codex/** export-ignore
.gemini/** export-ignore
__pycache__/** export-ignore
.pytest_cache/** export-ignore
.ruff_cache/** export-ignore
